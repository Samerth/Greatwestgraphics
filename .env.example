# Commerce API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/great_west_graphics
COMMERCE_API_HOST=127.0.0.1
COMMERCE_API_PORT=4000
COMMERCE_API_BASE_URL=http://127.0.0.1:4000

# Phase 2 local storefront/portal identity. These IDs match `npm run db:seed`.
# Development only: production authentication is intentionally not implemented.
COMMERCE_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
COMMERCE_DEV_ACCOUNT_ID=22222222-2222-4222-8222-222222222222
COMMERCE_DEV_STORE_ID=33333333-3333-4333-8333-333333333333
COMMERCE_DEV_CUSTOMER_PERSON_ID=44444444-4444-4444-8444-444444444444

# Optional: a separate, already-migrated database enables API integration tests.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gwg_test

# Local staff/admin smoke path. Keep false in production images.
ENABLE_DEV_ADMIN_ROUTES=true
DEV_ADMIN_TOKEN=local-dev-admin-token-min-16

# Staff admin shell login (Next.js /admin)
STAFF_ADMIN_USER=admin
STAFF_ADMIN_PASSWORD=local-staff-password
STAFF_SESSION_SECRET=local-session-secret-at-least-32-characters-long

# S&S Activewear Canada catalog (server-only — never expose to browser)
SS_ACCOUNT_NUMBER=
SS_API_KEY=
SS_API_BASE_URL=https://api-ca.ssactivewear.com

# Contact form email (Resend). Leave RESEND_API_KEY blank to log submissions
# instead of sending — useful for local dev without a real API key.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Great West Graphics <onboarding@resend.dev>
CONTACT_TO_EMAIL=info@greatwestgraphics.com

# Customer + staff auth (AWS Cognito). COGNITO_APP_CLIENT_SECRET is a real
# secret — server-side only, never sent to the browser.
COGNITO_REGION=ca-central-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
CUSTOMER_SESSION_SECRET=replace-with-a-long-random-session-secret

# Canonical public URL for sitemap/robots/OG tags — no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Design/artwork upload storage. Leave both blank to use the local
# filesystem fallback (.data/uploads, dev-only — not durable in a
# serverless or multi-instance deployment). Set both to switch to S3.
AWS_S3_BUCKET=
AWS_REGION=
# Optional: CloudFront/custom domain in front of the bucket. Falls back to
# the bucket's regional S3 URL when blank.
AWS_S3_PUBLIC_BASE_URL=
