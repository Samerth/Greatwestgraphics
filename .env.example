# Commerce API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/great_west_graphics
COMMERCE_API_HOST=127.0.0.1
COMMERCE_API_PORT=4000
COMMERCE_API_BASE_URL=http://127.0.0.1:4000

# Phase 2 local storefront/portal identity. These IDs match `npm run db:seed`.
# Development only: production authentication is intentionally not implemented.
COMMERCE_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
COMMERCE_DEV_ACCOUNT_ID=22222222-2222-4222-8222-222222222222
COMMERCE_DEV_STORE_ID=33333333-3333-4333-8333-333333333333
COMMERCE_DEV_CUSTOMER_PERSON_ID=44444444-4444-4444-8444-444444444444

# Optional: a separate, already-migrated database enables API integration tests.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gwg_test

# Disabled by default. Use a long local-only value when explicitly enabling.
ENABLE_DEV_ADMIN_ROUTES=false
DEV_ADMIN_TOKEN=replace-with-a-local-token-at-least-16-characters

# Future adapters are intentionally not configured in Phase 2.
# CODCRM_BASE_URL=
# STRIPE_SECRET_KEY=
# EMAIL_PROVIDER_API_KEY=
# VENDOR_API_BASE_URL=
