# =============================================================================
# Great West Graphics — environment template
# Copy to `.env` for local work. Never commit real secrets.
# Production: inject via AWS Secrets Manager / SSM (see docs/AWS_DEPLOYMENT.md).
# =============================================================================

# Commerce API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/great_west_graphics
# Containers / ECS: bind all interfaces. Local host-run can stay 127.0.0.1.
COMMERCE_API_HOST=127.0.0.1
COMMERCE_API_PORT=4000
# Server-only URL the Next.js app uses to reach the API (not browser-exposed).
COMMERCE_API_BASE_URL=http://127.0.0.1:4000

# Phase 2 local storefront/portal identity. These IDs match `npm run db:seed`.
# Development only — leave unset in production (no fixture identity).
COMMERCE_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
COMMERCE_DEV_ACCOUNT_ID=22222222-2222-4222-8222-222222222222
COMMERCE_DEV_STORE_ID=33333333-3333-4333-8333-333333333333
COMMERCE_DEV_CUSTOMER_PERSON_ID=44444444-4444-4444-8444-444444444444

# The single store a deployment serves, pinned rather than resolved. Set these
# and the storefront stops asking the API which store the inbound Host belongs
# to, because it already knows. Every AWS environment sets them (see
# infra/cloudshell/scripts/16-create-store.sh, which creates the rows and
# records the ids). Leave them unset only for a deployment that genuinely
# serves several stores and wants each one resolved from its own hostname.
# COMMERCE_DEFAULT_TENANT_ID=
# COMMERCE_DEFAULT_ACCOUNT_ID=
# COMMERCE_DEFAULT_STORE_ID=
# COMMERCE_DEFAULT_STORE_SLUG=great-west-graphics
# COMMERCE_DEFAULT_STORE_NAME=Great West Graphics

# Commerce API: domain under which a store's slug is also its subdomain, so
# acme.stores.example.com resolves the store with slug `acme`. Unset means
# /v1/stores/by-host answers only for a registered stores.custom_domain, and an
# unknown host resolves to nothing instead of to a store that happens to share
# its first label.
# COMMERCE_STOREFRONT_BASE_DOMAIN=

# Optional: a separate, already-migrated database enables API integration tests.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gwg_test

# Local staff/admin smoke path on commerce-api (/admin/*).
# MUST be false (or unset) in production — API refuses true when NODE_ENV=production.
ENABLE_DEV_ADMIN_ROUTES=true
DEV_ADMIN_TOKEN=local-dev-admin-token-min-16

# Staff admin shell login (Next.js /admin)
STAFF_ADMIN_USER=admin
STAFF_ADMIN_PASSWORD=local-staff-password
STAFF_SESSION_SECRET=local-session-secret-at-least-32-characters-long

# S&S Activewear Canada catalog (server-only — never expose to browser)
SS_ACCOUNT_NUMBER=
SS_API_KEY=
SS_API_BASE_URL=https://api-ca.ssactivewear.com

# SanMar Canada / ATC PromoStandards
# id = customer ID; password field = login e-mail (see ATC integration guide)
SANMAR_ACCOUNT_ID=
SANMAR_LOGIN_EMAIL=
# Legacy alias for SANMAR_LOGIN_EMAIL (must be the login e-mail, not website password)
SANMAR_API_PASSWORD=
SANMAR_API_BASE_URL=https://edi.atc-apparel.com
# Cap getProduct name/image enrichment only (sellable import is uncapped)
SANMAR_MAX_PRODUCTS=50
SANMAR_SELLABLE_MODE=ACTIVE
SANMAR_PRODUCT_IDS=
# Cap per-style inventory/pricing fallback when Bulk Data is unavailable (unset = all)
# SANMAR_INVENTORY_MAX=
# Separate EDI media password for getMediaContent (Primary images)
SANMAR_MEDIA_PASSWORD=
# Optional full URL overrides (default = production /pstd/ paths)
# SANMAR_INVENTORY_URL=https://edi.atc-apparel.com/pstd/inventory2.0/InventoryServiceV2.php
# SANMAR_PRICING_URL=https://edi.atc-apparel.com/pstd/productpricingconfiguration/PricingAndConfigurationService.php
# SANMAR_MEDIA_URL=https://edi.atc-apparel.com/pstd/mediacontent1.1/MediaContentService.php
# SANMAR_BULK_URL=https://edi.atc-apparel.com/bulk-data/BulkDataService.php
# Optional CSV fallback: products.csv + skus.csv (+ inventory.csv)
SANMAR_CSV_DIR=

# Contact form email (Resend). Leave RESEND_API_KEY blank to log submissions
# instead of sending — useful for local dev without a real API key. That
# fallback is development-only: in production a missing key makes the contact
# form return 503 rather than confirm a message it never sent.
#
# CONTACT_FROM_EMAIL must be on a domain verified in Resend. Resend's shared
# onboarding@resend.dev only delivers to the Resend account owner, so anything
# aimed at a customer is dropped.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Great West Graphics <noreply@greatwestgraphics.com>
CONTACT_TO_EMAIL=info@greatwestgraphics.com

# Customer + staff auth (AWS Cognito). COGNITO_APP_CLIENT_SECRET is a real
# secret — server-side only, never sent to the browser.
COGNITO_REGION=ca-central-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
CUSTOMER_SESSION_SECRET=replace-with-a-long-random-session-secret
# Used only when COGNITO_USER_POOL_ID is unset (local review). Never in production.
# LOCAL_CUSTOMER_EMAIL=customer@example.test
# LOCAL_CUSTOMER_PASSWORD=local-customer-password

# Canonical public URL for sitemap/robots/OG tags — no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Design/artwork upload storage. Leave both blank to use the local
# filesystem fallback (.data/uploads, dev-only — not durable in a
# multi-instance ECS deployment). Set both to switch to S3.
AWS_S3_BUCKET=
AWS_REGION=
# Optional: CloudFront/custom domain in front of the bucket. Falls back to
# the bucket's regional S3 URL when blank.
AWS_S3_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Production / AWS checklist (Secrets Manager or SSM — do not put real values here)
# Web task:  NODE_ENV=production, COMMERCE_API_BASE_URL, NEXT_PUBLIC_SITE_URL,
#            STAFF_*, CUSTOMER_SESSION_SECRET, COGNITO_*, AWS_S3_*, RESEND_*
# API task:  NODE_ENV=production, DATABASE_URL, COMMERCE_API_HOST=0.0.0.0,
#            COMMERCE_API_PORT=4000, ENABLE_DEV_ADMIN_ROUTES=false,
#            SS_*, SANMAR_* as needed
# Health:    web GET /api/health · api GET /health (liveness) · api GET /ready
# Docs:      docs/AWS_DEPLOYMENT.md
# -----------------------------------------------------------------------------
