{
  "name": "great-west-graphics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "npm run dev --workspace @gwg/commerce-api",
    "build": "next build",
    "build:all": "npm run build --workspaces --if-present && npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck --workspaces --if-present && npm run typecheck",
    "test": "npm run test:web && npm run test --workspaces --if-present",
    "test:web": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "npm run db:generate --workspace @gwg/commerce-api",
    "db:migrate": "npm run db:migrate --workspace @gwg/commerce-api",
    "db:seed": "npm run db:seed --workspace @gwg/commerce-api",
    "db:studio": "npm run db:studio --workspace @gwg/commerce-api",
    "sync:ss": "npm run sync:ss --workspace @gwg/commerce-api",
    "catalog:reclassify": "npm exec --workspace @gwg/commerce-api -- tsx src/scripts/reclassify-categories.ts",
    "catalog:seed-categories": "npm exec --workspace @gwg/commerce-api -- tsx src/scripts/seed-categories.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1098.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/client-sesv2": "^3.1098.0",
    "@gwg/contracts": "0.1.0",
    "@gwg/pricing": "0.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@neondatabase/serverless": "^0.10.4",
    "@next/third-parties": "^16.3.2",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.15.0",
    "konva": "^10.3.0",
    "lucide-react": "^0.469.0",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-konva": "^19.2.5",
    "resend": "^6.18.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1",
    "use-image": "^1.1.4",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
