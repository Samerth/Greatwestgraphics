{
  "name": "great-west-graphics",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "npm run dev --workspace @gwg/commerce-api",
    "build": "next build",
    "build:all": "npm run build --workspaces --if-present && npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck --workspaces --if-present && npm run typecheck",
    "test": "npm run test --workspaces --if-present",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "npm run db:generate --workspace @gwg/commerce-api",
    "db:migrate": "npm run db:migrate --workspace @gwg/commerce-api",
    "db:seed": "npm run db:seed --workspace @gwg/commerce-api",
    "db:studio": "npm run db:studio --workspace @gwg/commerce-api",
    "sync:ss": "npm run sync:ss --workspace @gwg/commerce-api"
  },
  "dependencies": {
    "@gwg/contracts": "0.1.0",
    "@gwg/pricing": "0.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.2",
    "framer-motion": "^11.15.0",
    "konva": "^10.3.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-konva": "^19.2.5",
    "strong-soap": "^3.2.6",
    "tailwind-merge": "^2.6.0",
    "use-image": "^1.1.4",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
