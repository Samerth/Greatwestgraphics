# Deployment
AWS_REGION=ca-central-1
PROJECT=gwg
ENVIRONMENT=prod

# Replace before running. Use a single trusted public IPv4 address with /32 or
# a trusted office CIDR. 0.0.0.0/0 is explicitly rejected.
PUBLIC_DB_ALLOWED_CIDR=REPLACE_WITH_TRUSTED_IPV4_CIDR

# Network
VPC_CIDR=10.43.0.0/16
PUBLIC_SUBNET_1_CIDR=10.43.0.0/24
PUBLIC_SUBNET_2_CIDR=10.43.1.0/24

# PostgreSQL
DB_NAME=great_west_graphics
DB_USERNAME=gwg_admin
RDS_INSTANCE_CLASS=db.t4g.small
RDS_ALLOCATED_STORAGE_GB=20
RDS_BACKUP_RETENTION_DAYS=7
RDS_MULTI_AZ=false

# Billing alerts
# AWS Budgets only supports USD (not CAD). Keep commerce/pricing in CAD separately.
BUDGET_AMOUNT=250
BUDGET_UNIT=USD
BUDGET_EMAIL=greatwestgraphics12@gmail.com
# AWS/Billing EstimatedCharges is published in USD in us-east-1.
BILLING_ALARM_USD=180

# Application (used by S3 / Cognito / ECS scripts)
STAFF_ADMIN_USER=admin
CONTACT_FROM_EMAIL="Great West Graphics <noreply@greatwestgraphics.com>"
CONTACT_TO_EMAIL=info@greatwestgraphics.com
# Optional custom hostnames. Leave blank to smoke-test on the ALB DNS name
# (HTTP :80 → web, HTTP :4000 → API). Set these when ACM + Route 53 are ready.
SITE_HOSTNAME=
API_HOSTNAME=

# Which store this environment serves. Leave blank: 16-create-store.sh creates
# the tenant/account/store rows, records their ids in the environment's state
# file, and 09-create-ecs.sh reads them from there. Set them by hand only to
# point a new environment at rows that already exist.
COMMERCE_DEFAULT_TENANT_ID=
COMMERCE_DEFAULT_ACCOUNT_ID=
COMMERCE_DEFAULT_STORE_ID=
COMMERCE_DEFAULT_STORE_NAME=Great West Graphics
COMMERCE_DEFAULT_STORE_SLUG=great-west-graphics

# Only for a stack serving several stores off one wildcard domain, where a
# store's slug is also its subdomain. Blank means the commerce API resolves a
# host only against a registered stores.custom_domain, so an unknown hostname
# resolves to nothing instead of to whichever store shares its first label.
COMMERCE_STOREFRONT_BASE_DOMAIN=

# GitHub OIDC (ECR push). Change if the repo moves.
GITHUB_ORG=Samerth
GITHUB_REPO=Greatwestgraphics
