# Great West Graphics — AWS Staging Environment Config
# Copy to config.staging.env and fill in your values
# Never commit actual secrets — this file is for template reference only

# ===== ENVIRONMENT =====
ENVIRONMENT=staging
AWS_REGION=ca-central-1

# ===== RDS CONFIGURATION =====
# Use smaller instance for staging to reduce costs
RDS_INSTANCE_CLASS=db.t4g.micro
RDS_STORAGE=20  # GB
RDS_BACKUP_RETENTION=7  # days

# ===== NETWORK =====
# Your public IP for SQL client access. Get it: curl -fsS https://checkip.amazonaws.com
PUBLIC_DB_ALLOWED_CIDR=0.0.0.0/0  # TODO: Replace with your IP/32

# ===== SITE HOSTNAME =====
# Set this after CloudFront is created (script 14)
# Until then, staging uses the CloudFront *.cloudfront.net name
SITE_HOSTNAME=staging.greatwestgraphics.com

# Optional: separate API hostname (not required if behind same ALB)
# API_HOSTNAME=api-staging.greatwestgraphics.com

# ===== CONTAINER IMAGES =====
# Set to a specific commit SHA to test a branch before merging
# Leave empty to use 'latest' tag (only moves on main push)
IMAGE_TAG=latest

# ===== EMAIL & NOTIFICATIONS =====
# Email for SNS budget alerts
SNS_ALERT_EMAIL=your-email@example.com

# Resend API key for contact form + notifications
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Staff notification email (job status updates)
STAFF_NOTIFICATION_EMAIL=staff@greatwestgraphics.com

# Notifications sender email (must be verified in Resend)
NOTIFICATIONS_FROM_EMAIL=noreply@greatwestgraphics.com

# Contact form submission email
CONTACT_TO_EMAIL=info@greatwestgraphics.com

# ===== COGNITO =====
# Configured automatically by script 06; these are optional overrides
# COGNITO_REGION=ca-central-1
# COGNITO_USER_POOL_ID=ca-central-1_xxxxxxxxx
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxx

# ===== VENDOR CREDENTIALS =====
# S&S Activewear Canada
SS_ACCOUNT_NUMBER=your-account-number
SS_API_KEY=your-api-key

# SanMar Canada / ATC (put real values in Secrets Manager, not this file)
# SANMAR_ACCOUNT_ID + login e-mail authenticate Product / Inventory / Pricing / Bulk.
# SANMAR_MEDIA_PASSWORD is a separate PromoStandards Media password — it does
# not unlock Bulk. ECS injects it only when the JSON key exists on the vendor
# secret (VENDOR_SECRET_ARN) or gwg-staging/api.
# SANMAR_ACCOUNT_ID=
# SANMAR_LOGIN_EMAIL=
# SANMAR_MEDIA_PASSWORD=

# Somar (optional, for SOAP EDI)
# SOMAR_API_USERNAME=username
# SOMAR_API_PASSWORD=password

# ===== STAFF AUTHENTICATION =====
# Used by web container for /admin login
STAFF_ADMIN_USER=admin
STAFF_ADMIN_PASSWORD=change-me-in-secrets-manager

# ===== APPLICATION SECRETS =====
# Session encryption keys (min 32 chars each)
STAFF_SESSION_SECRET=your-32-char-staff-session-secret-here
CUSTOMER_SESSION_SECRET=your-32-char-customer-session-secret-here
DEV_ADMIN_TOKEN=your-min-16-char-admin-token

# ===== AWS SECRETS MANAGER =====
# These ARNs are created by script 08 and populated here for reference
# Used by script 09 (ECS) to grant task access
# SECRETS_MANAGER_ARNS will be auto-populated after script 08

# ===== OPTIONAL: DATABASE SETUP =====
# To copy production data to staging (script 15):
# SOURCE_ENVIRONMENT=prod
# Include customer data in copy? (default: false, only copies catalog/pricing)
# INCLUDE_CUSTOMER_DATA=false
